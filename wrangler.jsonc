{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nenv",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dashboard/dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nenv",
      "migrations_dir": "worker/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SECRETS"
    }
  ]
}
